# Copie para .env somente no servidor. Nunca envie .env ao Git.
DB_USERNAME=rotati_app
DB_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-forte

APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
APP_URL_BASE=http://192.168.1.36:8080
SESSION_COOKIE_SECURE=false

# O e-mail e opcional durante o teste local.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_EMAIL_REMETENTE=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
